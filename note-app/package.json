{
  "name": "note-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "author": "Alihan",
  "description": "Not Uygulamasi",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron . --dev",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build:desktop": "vite build && electron-builder --win",
    "pack:mac": "vite build && electron-builder --mac zip"
  },
  "build": {
    "appId": "com.aliha.notuygulamasi",
    "productName": "Not Uygulamasi",
    "directories": {
      "output": "release/"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-easy-crop": "^5.5.7",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.14.2",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.4",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
